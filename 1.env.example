S3_SECRET_KEY=

# ===== يوتيوب: بحث + نشر =====
YOUTUBE_SEARCH_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# جديد: نفس CLIENT_ID/SECRET أعلاه، لكن refresh_token صادر بصلاحية إضافية
# yt-analytics.readonly (راجع تعليمات الإعداد أعلى planner/analytics_client.py).
# اختياري تمامًا - بدونه يستمر النظام بالعمل بمقاييس views/likes/comments فقط.
YOUTUBE_ANALYTICS_REFRESH_TOKEN=

