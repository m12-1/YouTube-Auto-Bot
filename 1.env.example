# ---------------------------------------------------------------------------
# Secrets (config/settings.py) -- only needed for the modules that call
# live APIs. Every module falls back gracefully if a key is missing.
# ---------------------------------------------------------------------------
GEMINI_KEY_ADVANCED=
GEMINI_KEY_FILTER=
GEMINI_KEY_FILTER_2=
GEMINI_KEY_IMAGE=
GEMINI_KEY_LIGHT=
GH_PAT=
GOOGLE_SERVICE_ACCOUNT_JSON=
GROQ_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
PUTER_USERNAME=
PUTER_PASSWORD=
SPREADSHEET_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# General / runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_RETRY_BASE_DELAY_SECONDS=1.0

# ---------------------------------------------------------------------------
# Script Generator / Script Reviewer
# ---------------------------------------------------------------------------
SCRIPT_MAX_SCENES=8
SCRIPT_TARGET_WORD_COUNT=150
SCRIPT_MIN_QUALITY_SCORE=0.7

# ---------------------------------------------------------------------------
# SEO Generator
# ---------------------------------------------------------------------------
SEO_MAX_TAGS=15
SEO_MAX_HASHTAGS=5
SEO_TITLE_MAX_LENGTH=100

# ---------------------------------------------------------------------------
# Storyboard / Media Planner
# ---------------------------------------------------------------------------
STORYBOARD_DEFAULT_SCENE_SECONDS=3.0
MEDIA_ALTERNATIVE_KEYWORD_COUNT=3
CAMERA_MOVEMENTS=zoom_in,zoom_out,pan_left,pan_right,static

# ---------------------------------------------------------------------------
# Media Downloader
# ---------------------------------------------------------------------------
MEDIA_CACHE_DIR=./cache/media
MEDIA_DOWNLOAD_MAX_ATTEMPTS=3
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=15.0
MEDIA_PROVIDER_PRIORITY=pexels,pixabay

# ---------------------------------------------------------------------------
# Media Quality Filter
# ---------------------------------------------------------------------------
MEDIA_MIN_WIDTH=1080
MEDIA_MIN_HEIGHT=1920
MEDIA_REQUIRED_ORIENTATION=portrait
MEDIA_MIN_DURATION_SECONDS=2.0
MEDIA_BLUR_THRESHOLD=100.0
MEDIA_BRIGHTNESS_MIN=25.0

# ---------------------------------------------------------------------------
# AI Media Verification
# ---------------------------------------------------------------------------
AI_MEDIA_VERIFICATION_MODEL=gemini-vision
AI_MEDIA_VERIFICATION_MIN_SCORE=0.5

# ---------------------------------------------------------------------------
# Voice Generator (Edge-TTS)
# ---------------------------------------------------------------------------
VOICE_AUDIO_OUTPUT_DIR=./output/audio
VOICE_CANDIDATES=en-US-GuyNeural,en-US-JennyNeural,en-GB-RyanNeural,en-GB-SoniaNeural
VOICE_SPEED_RANGE=-10%,0%,10%
VOICE_PITCH_RANGE=-2Hz,0Hz,2Hz
VOICE_NATURAL_PAUSE_MS=250

# ---------------------------------------------------------------------------
# Subtitle Generator
# ---------------------------------------------------------------------------
SUBTITLE_MAX_WORDS_PER_LINE=4
SUBTITLE_HIGHLIGHT_COLOR=#FFD700

# ---------------------------------------------------------------------------
# Video Composer / Renderer
# ---------------------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_OUTPUT_DIR=./output/video
VIDEO_TRANSITIONS=fade,slide,zoom_blur,whip_pan
VIDEO_KEN_BURNS_ENABLED=true

# ---------------------------------------------------------------------------
# Quality Inspector
# ---------------------------------------------------------------------------
QUALITY_MAX_DURATION_DRIFT_SECONDS=0.5
QUALITY_AUDIO_CLIP_THRESHOLD_DB=-0.1

# ---------------------------------------------------------------------------
# Phase 2 settings (unused by the current pipeline; kept for
# future/modules/ code -- see README "Phase 2 roadmap")
# ---------------------------------------------------------------------------
DB_BACKEND=json
ANALYTICS_COLLECTION_INTERVAL_HOURS=24
CLEANUP_INTERVAL_HOURS=168
REPORT_OUTPUT_DIR=./output/reports
KNOWLEDGE_DB_DIR=./db/knowledge
SIMILARITY_THRESHOLD=0.8
MONTHLY_UPLOAD_TARGET=30
SCHEDULER_TIMEZONE=UTC
